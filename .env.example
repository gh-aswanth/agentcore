# Copy to .env and fill in a real key:  cp .env.example .env
OPENAI_API_KEY=sk-replace-me

# Defaults below match docker-compose; override only if you run outside compose.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/agentcore
REDIS_URL=redis://redis:6379/0

JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Thinking mode. Applied only when CHAT_MODEL is a reasoning model (o1/o3/o4/gpt-5);
# with e.g. gpt-4o-mini the parameter is dropped instead of 400ing.
CHAT_MODEL=gpt-5-mini
REASONING_EFFORT=medium

# Token-level streaming of the agent's output over SSE.
STREAM_TOKENS=true
STREAM_DELTA_CHARS=24

MAX_AGENT_ITERATIONS=10
TOOL_TIMEOUT_SECONDS=5.0
SHORT_TERM_WINDOW=10
SHORT_TERM_RETAIN=20
LONG_TERM_TOP_K=3
MAX_CONCURRENT_RUNS_PER_USER=10
LOG_LEVEL=INFO
LOG_FORMAT=json
AGENT_RUN_TIME_LIMIT_SECONDS=900
WORKER_PREFETCH_MULTIPLIER=1
WORKER_MAX_TASKS_PER_CHILD=100
MAX_RUN_ATTEMPTS=3
